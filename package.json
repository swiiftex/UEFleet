{
  "name": "ue-fleet",
  "version": "1.0.0",
  "description": "Run many Claude agents on Unreal Engine at once, each with its own editor.",
  "main": "dist/loader.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/build.mjs && electron .",
    "demo": "node scripts/build.mjs && node scripts/demo.mjs",
    "test": "node scripts/build.mjs && node scripts/test.mjs",
    "test:ui": "node scripts/build.mjs && node test/ui.e2e.mjs",
    "package": "node scripts/package.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:watch": "node scripts/deploy.mjs --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "selfsigned": "^5.5.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "dompurify": "^3.4.17",
    "electron": "^45.2.1",
    "esbuild": "^0.28.2",
    "marked": "^18.1.2",
    "playwright-core": "^1.64.1",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
